{
  "name": "gbif-mcp",
  "version": "1.1.0",
  "description": "Model Context Protocol server for GBIF (Global Biodiversity Information Facility) API",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node build/index.js",
    "test": "vitest",
    "test:unit": "vitest tests/unit",
    "test:integration": "vitest tests/integration",
    "test:integration:mcp": "vitest tests/integration/mcp",
    "test:integration:api": "vitest tests/integration/api --run",
    "test:all": "vitest run tests/unit && vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "clean": "rimraf build",
    "typecheck": "tsc --noEmit",
    "test:integration:protocol": "vitest tests/integration/mcp/stdio-protocol.test.ts --run",
    "install:agents": "bash scripts/install.sh",
    "docs:tools": "node scripts/gen-tools-md.mjs TOOLS.md"
  },
  "keywords": [
    "mcp",
    "gbif",
    "biodiversity",
    "api",
    "model-context-protocol"
  ],
  "author": "",
  "license": "CC-BY-4.0",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "lru-cache": "^10.0.0",
    "p-queue": "^8.0.0",
    "winston": "^3.11.0",
    "zod": "^3.22.0",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "msw": "^2.0.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idss-mesa/gbif-mcp.git"
  },
  "homepage": "https://github.com/idss-mesa/gbif-mcp#readme",
  "bugs": {
    "url": "https://github.com/idss-mesa/gbif-mcp/issues"
  }
}
